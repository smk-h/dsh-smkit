{
  "name": "dsh-smkit",
  "version": "0.1.0",
  "description": "dsh-smkit — the minimal first-plugin example from the dsh cordis-tutorial (01-first-plugin): a function-form Cordis plugin that logs a hello line.",
  "type": "module",
  "license": "MIT",
  "author": "sumu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smk-h/dsh-smkit.git"
  },
  "bugs": {
    "url": "https://github.com/smk-h/dsh-smkit/issues"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "verify": "node test/verify.mjs",
    "prepack": "tsc -p tsconfig.json && node test/verify.mjs",
    "prepare": "tsc -p tsconfig.json"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "plugin"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "typescript": "7.0.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
