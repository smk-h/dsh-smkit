{
  "name": "@smai-kit/dsh-smkit",
  "version": "1.1.1",
  "description": "MCP server manager for DeepSeek Harness: Settings → MCP page, OAuth (PKCE + dynamic client registration) or static-token auth, local stdio servers, workspace isolation, and an opt-in on-demand tool broker.",
  "type": "module",
  "license": "MIT",
  "author": "sumu",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smk-h/dsh-smkit.git"
  },
  "bugs": {
    "url": "https://github.com/smk-h/dsh-smkit/issues"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "clean:lib": "rimraf lib",
    "build": "tsc -p tsconfig.json && tsdown",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/client/tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "dev:client": "tsdown --watch",
    "test": "node --test",
    "verify": "node test/verify.mjs",
    "smkit:install": "node scripts/dsh-smkit.mjs install",
    "smkit:uninstall": "node scripts/dsh-smkit.mjs uninstall",
    "smkit:debug": "node scripts/dsh-smkit.mjs debug",
    "pack:tgz": "pnpm pack",
    "pack:list": "node scripts/pack-list.mjs",
    "dsh:kill-port": "node scripts/kill-port.mjs",
    "dsh:open-config": "node scripts/open-dsh-config.mjs",
    "mock-provider": "node scripts/mock-provider.mjs --status 429",
    "http-mcp:serve": "node scripts/http-mcp-cli.mjs serve",
    "http-mcp:stop": "node scripts/http-mcp-cli.mjs stop",
    "prepack": "tsc -p tsconfig.json && tsdown && node test/verify.mjs",
    "prepare": "tsc -p tsconfig.json && tsdown"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "plugin",
    "mcp",
    "model-context-protocol",
    "oauth",
    "stdio"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.0",
    "typescript": "7.0.2"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.2-rc.1 <0.2.0",
      "node": "^22.19.0 || >=24.0.0",
      "profiles": [
        "web"
      ]
    }
  }
}
